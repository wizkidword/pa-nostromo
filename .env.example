# Local runtime settings for project-mission-control-lite
# Copy to .env (or .env.local) and adjust as needed.

# App server
PORT=4187

# Voice-to-Rowan relay
# Required for relay send to work.
ROWAN_RELAY_URL=http://127.0.0.1:8787/ingest

# Optional relay auth (leave blank for local trusted relays)
ROWAN_RELAY_AUTH_BEARER=
ROWAN_RELAY_AUTH_HEADER=Authorization

# Optional message guardrails
ROWAN_SEND_MAX_TEXT_LENGTH=2000
ROWAN_RELAY_TIMEOUT_MS=8000

# Optional OpenClaw routing hints (safe local defaults)
ROWAN_RELAY_OPENCLAW_CHANNEL=webchat
ROWAN_RELAY_OPENCLAW_TARGET=agent:main:main

# Security hardening: keep local-only by default.
# Set to 1 only behind trusted network controls.
ROWAN_ALLOW_REMOTE=0

# Camera snapshot proxy (used by Camera Feed pod snapshot mode)
# Comma-separated public hosts allowed beyond private/local ranges.
# Example: CAMERA_PROXY_ALLOWLIST=cam.example.com,cameras.internal.example
CAMERA_PROXY_ALLOWLIST=
# Keep local-only by default.
CAMERA_PROXY_ALLOW_REMOTE=0
# Snapshot proxy timeout (ms) and max payload size (bytes)
CAMERA_PROXY_TIMEOUT_MS=7000
CAMERA_PROXY_MAX_BYTES=5242880

# RSS fetch endpoint guardrails (used by RSS pod)
# Keep local-only by default.
RSS_FETCH_ALLOW_REMOTE=0
RSS_FETCH_TIMEOUT_MS=12000
RSS_FETCH_MAX_BYTES=2097152
RSS_FETCH_MAX_FEEDS=12

# Gas provider bake-off harness (RapidAPI)
# Required key for calls to RapidAPI hosts.
RAPIDAPI_KEY=
# Optional provider definitions (JSON array). If empty, script uses placeholder defaults.
# Example:
# GAS_BAKEOFF_PROVIDERS_JSON=[{"name":"FuelAPI","host":"fuel-prices.p.rapidapi.com","path":"/stations","method":"GET","query":{"zip":"{location}"}}]
GAS_BAKEOFF_PROVIDERS_JSON=

# Facebook followers pod (Graph API primary, public page scrape fallback)
META_GRAPH_API_VERSION=v22.0
META_GRAPH_PAGE_ID=
META_GRAPH_PAGE_ACCESS_TOKEN=
# Used when Graph API credentials are missing/invalid or Graph fetch fails.
# Best-effort estimate from public HTML; values can lag or break when Facebook markup changes.
FACEBOOK_PAGE_URL=https://www.facebook.com/blastfromtheads
META_GRAPH_POLL_INTERVAL_MS=60000
META_GRAPH_TIMEOUT_MS=8000
META_GRAPH_MAX_RETRIES=3
META_GRAPH_BACKOFF_BASE_MS=1000
META_GRAPH_BACKOFF_MAX_MS=15000
META_GRAPH_STALE_AFTER_MS=180000
META_GRAPH_CRITICAL_STALE_AFTER_MS=900000
META_GRAPH_ALLOW_REMOTE=0

# Instagram followers pod (Meta Business Suite primary)
INSTAGRAM_PROVIDER=meta_suite
INSTAGRAM_POLL_INTERVAL_MS=180000
INSTAGRAM_PROFILE_HANDLE=ablastfromtheads
INSTAGRAM_PROFILE_NAME=Blast From The Ads
INSTAGRAM_PROFILE_URL=https://www.instagram.com/ablastfromtheads/
INSTAGRAM_META_SUITE_URL=https://business.facebook.com/latest/insights
INSTAGRAM_META_SUITE_STORAGE_PATH=./data/.auth/meta-suite-instagram-storage.json
INSTAGRAM_META_SUITE_TIMEOUT_MS=45000
# Set INSTAGRAM_META_SUITE_HEADFUL=1 for troubleshooting / initial selector tuning.
INSTAGRAM_META_SUITE_HEADFUL=0
# Optional static seed used only if no prior value exists and provider chain fails.
INSTAGRAM_FOLLOWERS_COUNT=

# TikTok followers pod (public scrape estimate)
TIKTOK_POLL_INTERVAL_MS=180000
TIKTOK_PROFILE_HANDLE=ablastfromtheads
TIKTOK_PROFILE_NAME=Blast From The Ads
# Example: https://www.tiktok.com/@yourhandle
TIKTOK_PROFILE_URL=https://www.tiktok.com/@ablastfromtheads
# Optional static baseline for sanity checks only; never force-overwrites on scrape failure.
TIKTOK_FOLLOWERS_COUNT=

# YouTube subscribers pod (public scrape estimate)
YOUTUBE_POLL_INTERVAL_MS=180000
YOUTUBE_CHANNEL_NAME=Blast From The Ads
# Example: https://www.youtube.com/@yourhandle
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@Blastfromtheads
# Optional static baseline for sanity checks only; never force-overwrites on scrape failure.
YOUTUBE_SUBSCRIBERS_COUNT=
