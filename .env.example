# Local runtime settings for project-mission-control-lite
# Copy to .env (or .env.local) and adjust as needed.

# App server
PORT=4287
# Bind to localhost by default. Use 0.0.0.0 only behind trusted network controls.
HOST=127.0.0.1
# Runtime storage locations. Leave blank to use the private OS app-data location.
# Existing ./data and ./logs installs migrate by copy on first start; originals stay intact.
DATA_DIR=
LOG_DIR=
# JSONL operational logs rotate at this many bytes and retain this many files per log.
# The server enforces a minimum 64 KiB and two retained files.
LOG_ROTATION_MAX_BYTES=1048576
LOG_RETENTION_FILES=5

# Request host and remote API authorization. Defaults allow localhost/127.0.0.1/[::1] only.
# For a reverse proxy, list explicit host[:port] values, for example dashboard.example.com.
NOSTROMO_ALLOWED_HOSTS=
# Scoped remote tokens. Keep blank for a local-only dashboard.
# Example: NOSTROMO_API_TOKENS_JSON=[{"token":"replace-with-long-random-value","scopes":["state:read","state:write","email:read"]}]
NOSTROMO_API_TOKENS_JSON=
# Legacy state-only token compatibility. Prefer NOSTROMO_API_TOKENS_JSON for new setups.
# State API safety. Remote state access requires explicit opt-in plus a matching scoped token.
STATE_API_ALLOW_REMOTE=0
NOSTROMO_API_TOKEN=

# Request body limits (bytes)
REQUEST_BODY_LIMIT_ACTION_BYTES=65536
REQUEST_BODY_LIMIT_STATE_BYTES=2097152
REQUEST_BODY_LIMIT_RSS_BYTES=262144

# Voice-to-Rowan relay
# Required for relay send to work.
ROWAN_RELAY_URL=http://127.0.0.1:8787/ingest

# Optional relay auth (leave blank for local trusted relays)
ROWAN_RELAY_AUTH_BEARER=
ROWAN_RELAY_AUTH_HEADER=Authorization

# Optional message guardrails
ROWAN_SEND_MAX_TEXT_LENGTH=2000
ROWAN_RELAY_TIMEOUT_MS=8000

# Optional OpenClaw routing hints (safe local defaults)
ROWAN_RELAY_OPENCLAW_CHANNEL=webchat
ROWAN_RELAY_OPENCLAW_TARGET=agent:main:main

# Security hardening: keep local-only by default.
# Set to 1 only behind trusted network controls.
ROWAN_ALLOW_REMOTE=0

# Camera snapshot proxy (used by Camera Feed pod snapshot mode)
# Required: comma-separated public camera hostnames allowed by the proxy.
# Private, loopback, link-local, and internal-network destinations are always rejected.
# Example: CAMERA_PROXY_ALLOWLIST=cam.example.com
CAMERA_PROXY_ALLOWLIST=
# Keep local-only by default.
CAMERA_PROXY_ALLOW_REMOTE=0
# Snapshot proxy timeout (ms) and max payload size (bytes)
CAMERA_PROXY_TIMEOUT_MS=7000
CAMERA_PROXY_MAX_BYTES=5242880

# RSS fetch endpoint guardrails (used by RSS pod)
# Keep local-only by default.
RSS_FETCH_ALLOW_REMOTE=0
RSS_FETCH_TIMEOUT_MS=12000
RSS_FETCH_MAX_BYTES=2097152
RSS_FETCH_MAX_FEEDS=12
RSS_FETCH_MAX_ENTRIES=40
RSS_FETCH_CACHE_TTL_MS=300000
# Bounded refresh retry policy. Parser failures are not retried.
RSS_FETCH_MAX_ATTEMPTS=2
RSS_FETCH_BACKOFF_BASE_MS=500
RSS_FETCH_BACKOFF_MAX_MS=2000
RSS_FETCH_OPERATION_TIMEOUT_MS=20000
RSS_FETCH_UNHEALTHY_COOLDOWN_MS=30000

# Shared outbound-work limits. Identical requests are deduplicated while running.
OUTBOUND_MAX_CONCURRENCY=4
OUTBOUND_PER_HOST_CONCURRENCY=1
MANUAL_REFRESH_COOLDOWN_MS=3000

# Gas-price proxy (AAA state-average reads)
GAS_PROXY_ALLOW_REMOTE=0
GAS_PROXY_TIMEOUT_MS=10000
# Read-only AAA retry policy. Parser failures are not retried.
GAS_PROXY_READ_MAX_ATTEMPTS=2
GAS_PROXY_READ_BACKOFF_BASE_MS=500
GAS_PROXY_READ_BACKOFF_MAX_MS=2000
GAS_PROXY_READ_OPERATION_TIMEOUT_MS=15000
GAS_PROXY_READ_UNHEALTHY_COOLDOWN_MS=30000

# Unread email pod (Gmail Atom feed bridge)
# Uses a Gmail or Google Workspace mailbox with an app password.
# Keep local-only by default.
EMAIL_UNREAD_ALLOW_REMOTE=0
EMAIL_UNREAD_TIMEOUT_MS=8000
# Gmail Atom read-only snapshot retry policy. IMAP message actions do not use these retries.
EMAIL_UNREAD_MAX_ATTEMPTS=2
EMAIL_UNREAD_BACKOFF_BASE_MS=500
EMAIL_UNREAD_BACKOFF_MAX_MS=2000
EMAIL_UNREAD_OPERATION_TIMEOUT_MS=15000
EMAIL_UNREAD_UNHEALTHY_COOLDOWN_MS=30000
EMAIL_UNREAD_PROVIDER=gmail_imap
EMAIL_UNREAD_URL=https://mail.google.com/mail/feed/atom
EMAIL_UNREAD_IMAP_HOST=imap.gmail.com
EMAIL_UNREAD_IMAP_PORT=993
EMAIL_UNREAD_PREVIEW_LIMIT=5
EMAIL_UNREAD_LABEL=Inbox
# Single-account fallback:
EMAIL_UNREAD_USERNAME=
EMAIL_UNREAD_APP_PASSWORD=
EMAIL_UNREAD_OPEN_URL=https://mail.google.com/mail/u/0/#inbox
# Multi-account option (preferred for 2+ inboxes):
# EMAIL_UNREAD_ACCOUNTS_JSON=[{"label":"Primary","username":"primary@gmail.com","appPassword":"app-password-1","openUrl":"https://mail.google.com/mail/u/0/#inbox"},{"label":"Brand","username":"brand@gmail.com","appPassword":"app-password-2","openUrl":"https://mail.google.com/mail/u/1/#inbox","includeSent":true,"sentOpenUrl":"https://mail.google.com/mail/u/1/#sent"},{"label":"Ops","username":"ops@gmail.com","appPassword":"app-password-3","openUrl":"https://mail.google.com/mail/u/2/#inbox"}]
EMAIL_UNREAD_ACCOUNTS_JSON=

# eBay traffic pod (Sell Analytics API via seller OAuth refresh token)
# Official docs:
# - Traffic report: https://developer.ebay.com/api-docs/sell/analytics/resources/traffic_report/methods/getTrafficReport
# - Refresh token flow: https://developer.ebay.com/api-docs/static/oauth-refresh-token-request.html
EBAY_TRAFFIC_ALLOW_REMOTE=0
EBAY_TRAFFIC_ENVIRONMENT=production
EBAY_TRAFFIC_TIMEOUT_MS=12000
# Read-only Sell Analytics GET traffic-report retry policy. OAuth and Marketing calls do not use these retries.
EBAY_TRAFFIC_READ_MAX_ATTEMPTS=2
EBAY_TRAFFIC_READ_BACKOFF_BASE_MS=500
EBAY_TRAFFIC_READ_BACKOFF_MAX_MS=2000
EBAY_TRAFFIC_READ_OPERATION_TIMEOUT_MS=20000
EBAY_TRAFFIC_READ_UNHEALTHY_COOLDOWN_MS=30000
EBAY_TRAFFIC_RANGE_DAYS=30
EBAY_TRAFFIC_TOP_LISTINGS_LIMIT=8
EBAY_TRAFFIC_CACHE_TTL_MS=1800000
EBAY_TRAFFIC_RATE_LIMIT_BACKOFF_MS=3600000
EBAY_TRAFFIC_SCOPE=https://api.ebay.com/oauth/api_scope/sell.analytics.readonly https://api.ebay.com/oauth/api_scope/sell.marketing
# Single-store fallback:
EBAY_TRAFFIC_LABEL=eBay Store
EBAY_TRAFFIC_MARKETPLACE_ID=EBAY_US
EBAY_TRAFFIC_CLIENT_ID=
EBAY_TRAFFIC_CLIENT_SECRET=
EBAY_TRAFFIC_REFRESH_TOKEN=
EBAY_TRAFFIC_STORE_URL=
# Multi-store option:
# EBAY_TRAFFIC_STORES_JSON=[{"label":"Jrock Cards","marketplaceId":"EBAY_US","clientId":"your-client-id","clientSecret":"your-client-secret","refreshToken":"your-refresh-token","storeUrl":"https://www.ebay.com/str/your-store"},{"label":"Collectibles","marketplaceId":"EBAY_US","clientId":"your-client-id","clientSecret":"your-client-secret","refreshToken":"your-refresh-token","storeUrl":"https://www.ebay.com/str/your-second-store"}]
EBAY_TRAFFIC_STORES_JSON=

# Gas provider bake-off harness (RapidAPI)
# Required key for calls to RapidAPI hosts.
RAPIDAPI_KEY=
# Optional provider definitions (JSON array). If empty, script uses placeholder defaults.
# Example:
# GAS_BAKEOFF_PROVIDERS_JSON=[{"name":"FuelAPI","host":"fuel-prices.p.rapidapi.com","path":"/stations","method":"GET","query":{"zip":"{location}"}}]
GAS_BAKEOFF_PROVIDERS_JSON=

# Facebook followers pod (Graph API primary, public page scrape fallback)
META_GRAPH_API_VERSION=v22.0
META_GRAPH_PAGE_ID=
META_GRAPH_PAGE_ACCESS_TOKEN=
# Used when Graph API credentials are missing/invalid or Graph fetch fails.
# Best-effort estimate from public HTML; values can lag or break when Facebook markup changes.
FACEBOOK_PAGE_URL=https://www.facebook.com/blastfromtheads
FACEBOOK_GROUP_URL=https://www.facebook.com/groups/blastfromtheads
FACEBOOK_GROUP_POLL_INTERVAL_MS=180000
FACEBOOK_SESSION_SCRIPT_PATH=./scripts/facebook-page-session-scraper.mjs
FACEBOOK_GROUP_SESSION_SCRIPT_PATH=./scripts/facebook-group-session-scraper.mjs
# Leave blank to keep browser-session storage under DATA_DIR/.auth.
FACEBOOK_SESSION_STORAGE_PATH=
FACEBOOK_SESSION_TIMEOUT_MS=45000
# Set FACEBOOK_SESSION_HEADFUL=1 for troubleshooting the authenticated fallback.
FACEBOOK_SESSION_HEADFUL=0
FACEBOOK_CONTENT_CACHE_TTL_MS=600000
FACEBOOK_GRAPH_LOOKBACK_DAYS=7
FACEBOOK_GRAPH_POST_LIMIT=12
META_GRAPH_POLL_INTERVAL_MS=60000
META_GRAPH_TIMEOUT_MS=8000
META_GRAPH_MAX_RETRIES=3
META_GRAPH_BACKOFF_BASE_MS=1000
META_GRAPH_BACKOFF_MAX_MS=15000
# Maximum wall-clock time for the full Graph API retry operation.
META_GRAPH_OPERATION_TIMEOUT_MS=20000
# Pause Graph API attempts after retryable failures; session/public fallbacks still run.
META_GRAPH_UNHEALTHY_COOLDOWN_MS=30000
META_GRAPH_STALE_AFTER_MS=180000
META_GRAPH_CRITICAL_STALE_AFTER_MS=900000
META_GRAPH_ALLOW_REMOTE=0

# Instagram followers pod (Graph API first, session fallback)
INSTAGRAM_PROVIDER=auto
INSTAGRAM_POLL_INTERVAL_MS=180000
INSTAGRAM_PROFILE_HANDLE=ablastfromtheads
INSTAGRAM_PROFILE_NAME=Blast From The Ads
INSTAGRAM_PROFILE_URL=https://www.instagram.com/ablastfromtheads/
INSTAGRAM_GRAPH_PAGE_ID=
INSTAGRAM_GRAPH_ACCOUNT_ID=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_TIMEOUT_MS=8000
INSTAGRAM_GRAPH_LOOKBACK_DAYS=7
INSTAGRAM_GRAPH_MEDIA_LIMIT=12
INSTAGRAM_META_SUITE_URL=https://business.facebook.com/latest/insights
# Leave blank to keep browser-session storage under DATA_DIR/.auth.
INSTAGRAM_META_SUITE_STORAGE_PATH=
INSTAGRAM_META_SUITE_TIMEOUT_MS=45000
# Set INSTAGRAM_META_SUITE_HEADFUL=1 for troubleshooting / initial selector tuning.
INSTAGRAM_META_SUITE_HEADFUL=0
# Optional static seed used only if no prior value exists and provider chain fails.
INSTAGRAM_FOLLOWERS_COUNT=

# TikTok followers pod (public scrape estimate)
TIKTOK_POLL_INTERVAL_MS=180000
TIKTOK_PROFILE_HANDLE=ablastfromtheads
TIKTOK_PROFILE_NAME=Blast From The Ads
# Example: https://www.tiktok.com/@yourhandle
TIKTOK_PROFILE_URL=https://www.tiktok.com/@ablastfromtheads
# Optional static baseline for sanity checks only; never force-overwrites on scrape failure.
TIKTOK_FOLLOWERS_COUNT=

# YouTube subscribers pod (public scrape estimate)
YOUTUBE_POLL_INTERVAL_MS=180000
YOUTUBE_CHANNEL_NAME=Blast From The Ads
# Example: https://www.youtube.com/@yourhandle
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@Blastfromtheads
# Optional static baseline for sanity checks only; never force-overwrites on scrape failure.
YOUTUBE_SUBSCRIBERS_COUNT=
